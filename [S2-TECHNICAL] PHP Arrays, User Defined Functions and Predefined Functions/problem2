
<?php

function cube($s) {
    return $s * $s * $s;
}

function rectangularPrism($l, $w, $h) {
    return $l * $w * $h;
}

function cylinder($r, $h) {
    return 3.14 * $r * $r * $h;
}

function sphere($r) {
    return (4/3) * 3.14 * $r * $r * $r;
}

$s = 5;
$l = 4; $w = 3; $h = 2;
$r = 3;
?>

